#!/bin/zsh
#
# Download YouTube videos as mp4 with yt-dlp. Audio is handled by `ydla`;
# the old `audio` / `aac` modes forward there.
#
#   ytdl URL...
#   ytdl video URL...   (same thing)
#   ytdl audio URL...   (ydla mp3)
#   ytdl aac URL...     (ydla aac)

case "$1" in
  audio) shift; ydla mp3 "$@"; return ;;
  aac)   shift; ydla aac "$@"; return ;;
  video) shift ;;
esac

if [ $# -eq 0 ]; then
  echo "Usage: ytdl [video|audio|aac] URL..."
  return 1
fi

yt-dlp -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" \
  --ignore-errors \
  --no-overwrites \
  --download-archive downloaded.txt \
  "$@"
