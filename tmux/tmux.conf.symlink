#!/usr/bin/zsh

# Create session if none exists
new-session -n "#{host_short}"

# improve colors
set -g default-terminal "screen-256color"
# set -g default-terminal "xterm"

# Change prefix key to backtick and still type backticks
unbind C-b
set-option -g prefix `
bind ` send-prefix

setw -g pane-base-index 1
set -g base-index 1

set -s escape-time 10
# Increase repeat time for repeated commands
set -g repeat-time 200
# Turn off aggressive resizing which can cause heavy redraws on multi-client setups
setw -g aggressive-resize off
# Disable visual and audio bells that trigger unnecessary redraws/output
set -g visual-bell off
set -g visual-activity off
set -g bell-action none
set -g history-limit 10000

# Status bar
setw -g clock-mode-style 12
set -g status-interval 5
set -g status-right "#{pomodoro_status} | %a %d %b %I:%M %p "
set -g status-left "#S "
set -g status-style "bg=#222222,fg=#cccccc"
set -g status-left-style "bg=green,fg=black,bold"
set -g status-right-style "fg=#bbbbbb"
setw -g window-status-format " #I:#W "
setw -g window-status-current-format " #I:#W "
setw -g window-status-current-style "fg=cyan,bold"
setw -g window-status-style "fg=#888888"

# set pane colors - highlight the active pane
# set-option -g pane-border-fg colour235 #base02
# set-option -g pane-active-border-fg colour240 #base01

## set zsh default shell
# set-option -g default-shell "$(which zsh)"
# set-option -g default-shell "/opt/homebrew/bin/zsh"
set-option -g default-shell ${SHELL}
set -g default-command 'builtin cd "#{pane_current_path}" 2>/dev/null; exec $SHELL'

# set color for status bar
set-option -g renumber-windows on

# intutive pane splitting
unbind %
bind | split-window -h -c "#{pane_current_path}"
bind \\ split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

bind-key w run "tmux split-window -l 12 'zsh -ci fzf_windows'"

# pane resizing
bind k resize-pane -U 5
bind j resize-pane -D 5
bind h resize-pane -L 5
bind l resize-pane -R 5

# pane helpers
bind Space last-pane
bind = select-layout even-horizontal

# reload config
bind r source-file ~/.tmux.conf \; display "Reloaded .tmux.conf"

# send prefix to inner tmux
bind-key a send-prefix

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @resurrect-processes 'false'
set -g @continuum-restore 'on'


# --- clipboard / mouse ---------------------------------------------------
# Ptyxis/VTE does not implement OSC 52 clipboard writes (verified), so
# set-clipboard alone never reaches the system clipboard there. Keep OSC 52
# enabled for terminals that DO support it (Ghostty, kitty, wezterm, foot) and
# for SSH peers, but drive every copy through a real helper:
# wl-copy (Wayland) -> xclip -> xsel.
set -g set-clipboard on

# tmux 3.8 defaults the mouse to on -- keep it, and make it explicit.
set -g mouse on

# Copy on drag release: letting go of the mouse after a drag pipes the
# selection straight to the system clipboard and exits copy mode. y / Enter
# do the same from the keyboard.
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -b'
bind -T copy-mode    MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -b'
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -b'
bind -T copy-mode-vi y     send-keys -X copy-pipe-and-cancel 'wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -b'
bind -T copy-mode   Enter send-keys -X copy-pipe-and-cancel 'wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -b'
bind -T copy-mode   y     send-keys -X copy-pipe-and-cancel 'wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -b'

# tmux 3.8's new Ctrl+<mouse> defaults pop up surprise windows mid-gesture:
# Ctrl+drag floats a new pane that follows the cursor, Ctrl+click breaks the
# pane into a new window / zooms it / opens a "Kill pane?" menu. (The Cmd key
# on this keyboard sends Ctrl, so these were easy to hit by accident.)
# Drop them; the plain right-click context menu is kept.
unbind -T root MouseDown1Control7
unbind -T root MouseDown1Control8
unbind -T root MouseDown1Control9
unbind -T root C-MouseDrag1Pane
unbind -T root C-MouseDrag1Empty

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
