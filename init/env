#!/bin/sh

OS="$(uname -s)"
ARCH="$(uname -m)"

OS_NAME="unknown"
case "$OS" in
  Darwin) OS_NAME="macos" ;;
  Linux)  OS_NAME="linux" ;;
esac

export OS OS_NAME ARCH

IS_MAC=false
IS_LINUX=false
[ "$OS_NAME" = "macos" ] && IS_MAC=true
[ "$OS_NAME" = "linux" ] && IS_LINUX=true
export IS_MAC IS_LINUX

# Homebrew / Linuxbrew on PATH only if present.
if [ -d /opt/homebrew ]; then
  export PATH="/opt/homebrew/bin:$PATH"
fi
if [ -d /home/linuxbrew/.linuxbrew ]; then
  export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
fi

# Canonical tool homes.
export NVM_DIR="${HOME}/.nvm"
export ZPLUG_HOME="${HOME}/.zplug"

# fnm — Fast Node Manager
FNM_PATH="${HOME}/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
fi

# Ruby via Homebrew / Linuxbrew (only when brew is present).
if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="$(brew --prefix)"
  export PATH="$BREW_PREFIX/opt/ruby/bin:$BREW_PREFIX/sbin:$PATH"
  unset BREW_PREFIX
fi

# Ruby gems — install into ~/gems and add the per-version gem bin dir.
export GEM_HOME="$HOME/gems"
export PATH="$HOME/gems/bin:$PATH"
if command -v ruby >/dev/null 2>&1; then
  RUBY_GEM_BIN="$HOME/.gem/ruby/$(ruby -e 'print RbConfig::CONFIG["ruby_version"]')/bin"
  if [ -d "$RUBY_GEM_BIN" ]; then
    export PATH="$RUBY_GEM_BIN:$PATH"
  fi
  unset RUBY_GEM_BIN
fi

# npm / yarn global prefixes
if [ -d "$HOME/.npm-packages/bin" ]; then
  export PATH="$HOME/.npm-packages/bin:$PATH"
fi
if [ -d "$HOME/.yarn/bin" ]; then
  export PATH="$HOME/.yarn/bin:$PATH"
fi

# pnpm
if [ -d "$HOME/.local/share/pnpm" ]; then
  export PNPM_HOME="$HOME/.local/share/pnpm"
  case ":$PATH:" in
    *":$PNPM_HOME/bin:"*) ;;
    *) export PATH="$PNPM_HOME/bin:$PATH" ;;
  esac
fi

# LM Studio CLI (lms)
if [ -d "$HOME/.lmstudio/bin" ]; then
  export PATH="$HOME/.lmstudio/bin:$PATH"
fi

# opencode
if [ -d "$HOME/.opencode/bin" ]; then
  export PATH="$HOME/.opencode/bin:$PATH"
fi

# User-level binaries (Hermes agent, codebase-memory-mcp, etc.)
if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi
