#!/usr/bin/env bash
#
# bootstrap installs things.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

# Load OS detection (POSIX-compatible) so the rest can use $IS_MAC/$IS_LINUX.
if [ -f "$DOTFILES_ROOT/init/env" ]; then
  source "$DOTFILES_ROOT/init/env"
fi

echo ''

info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

user () {
  printf "\r  [ \033[0;33m??\033[0m ] $1\n"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

setup_gitconfig () {
  if ! [ -f git/gitconfig.symlink ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$IS_MAC" = true ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.symlink.example > git/gitconfig.symlink

    success 'gitconfig'
  fi
}

setup_npmconfig () {
  if ! [ -f npm/npmrc.symlink ]
  then
    info 'setup npmconfig'

    git_credential='cache'
    if [ "$IS_MAC" = true ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your npm author name?'
    read -e npm_authorname
    user ' - What is your npm author email?'
    read -e npm_authoremail
    user ' - What is your npm author url?'
    read -e npm_authorurl

    sed -e "s/NPMAUTHORNAME/$npm_authorname/g" -e "s/NPMAUTHOREMAIL/$npm_authoremail/g" -e "s/NPMAUTHORURL/$npm_authorurl/g" npm/npmrc.symlink.example > npm/npmrc.symlink

    success 'npmconfig'
  fi
}

setup_git_hooks () {
  mkdir -p ~/.git-templates/hooks

  # give execute permissions 
  chmod a+x ~/.git-templates/hooks/*
}

setup_localrc () {
  # Scratch space for ad-hoc installer exports (gitignored).
  mkdir -p "$HOME/.zshrc.d"

  if ! [ -f "$HOME/.localrc" ]
  then
    info 'setup localrc'
    cp "$DOTFILES_ROOT/zsh/localrc.example" "$HOME/.localrc"
    success 'created ~/.localrc from template (fill in your secrets)'
  fi
}

link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
      [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
      read -n 1 action

      case "$action" in
        o )
        overwrite=true;;
        O )
        overwrite_all=true;;
        b )
        backup=true;;
        B )
        backup_all=true;;
        s )
        skip=true;;
        S )
        skip_all=true;;
        * )
        ;;
      esac
    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  for src in $(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink')
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done
}

setup_gitconfig
setup_npmconfig
setup_localrc
install_dotfiles

# If brew (Homebrew/Linuxbrew) exists, install and setup dependencies.
# Works on both macOS and Linux now — no more Darwin-only assumption.
if command -v brew >/dev/null 2>&1
then
  info "installing dependencies"
  if source bin/dot > /tmp/dotfiles-dot 2>&1
  then
    success "dependencies installed"
  else
    fail "error installing dependencies"
  fi
fi

echo ''
echo '  All installed!'
