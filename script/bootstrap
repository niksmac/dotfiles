#!/usr/bin/env bash
#
# bootstrap installs things.

set -euo pipefail

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

# Load OS detection (POSIX-compatible) so the rest can use $IS_MAC/$IS_LINUX.
if [ -f "$DOTFILES_ROOT/init/env" ]; then
  source "$DOTFILES_ROOT/init/env"
fi

echo ''

info () {
  printf '\r  [ \033[00;34m..\033[0m ] %s\n' "$1"
}

user () {
  printf '\r  [ \033[0;33m??\033[0m ] %s\n' "$1"
}

success () {
  printf '\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n' "$1"
}

fail () {
  printf '\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n' "$1"
  echo ''
  exit 1
}

# Escape a string for use as a sed replacement (handles /, &, and \).
sed_escape () {
  printf '%s' "$1" | sed -e 's/[\/&\\]/\\&/g'
}

setup_gitconfig () {
  if ! [ -f git/gitconfig.symlink ]
  then
    info 'setup gitconfig'

    # Both helpers persist credentials (`cache` would forget them after 15 min).
    git_credential='!gh auth git-credential'
    if [ "$IS_MAC" = true ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -r git_authorname
    user ' - What is your github author email?'
    read -r git_authoremail

    sed -e "s/AUTHORNAME/$(sed_escape "$git_authorname")/g" \
        -e "s/AUTHOREMAIL/$(sed_escape "$git_authoremail")/g" \
        -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" \
        git/gitconfig.symlink.example > git/gitconfig.symlink

    success 'gitconfig'
  fi
}

setup_npmconfig () {
  if ! [ -f npm/npmrc.symlink ]
  then
    info 'setup npmconfig'

    user ' - What is your npm author name?'
    read -r npm_authorname
    user ' - What is your npm author email?'
    read -r npm_authoremail
    user ' - What is your npm author url?'
    read -r npm_authorurl

    sed -e "s/NPMAUTHORNAME/$(sed_escape "$npm_authorname")/g" \
        -e "s/NPMAUTHOREMAIL/$(sed_escape "$npm_authoremail")/g" \
        -e "s/NPMAUTHORURL/$(sed_escape "$npm_authorurl")/g" \
        npm/npmrc.symlink.example > npm/npmrc.symlink

    success 'npmconfig'
  fi
}

setup_localrc () {
  # Scratch space for ad-hoc installer exports (gitignored).
  mkdir -p "$HOME/.zshrc.d"

  if ! [ -f "$HOME/.localrc" ]
  then
    info 'setup localrc'
    cp "$DOTFILES_ROOT/zsh/localrc.example" "$HOME/.localrc"
    success 'created ~/.localrc from template (fill in your secrets)'
  fi
}

link_file () {
  local src=$1 dst=$2

  local overwrite='' backup='' skip=''
  local action=''

  # Idempotent: already pointing where we want → nothing to do, no prompt.
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]
  then
    success "already linked $src to $dst"
    return 0
  fi

  if [ -f "$dst" ] || [ -d "$dst" ] || [ -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      user "File already exists: $dst ($(basename "$src")), what do you want to do?"
      user "[s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all? (Enter=skip)"
      while true
      do
        read -r -n 1 action || action="s"
        echo
        case "$action" in
          o )
          overwrite=true; break;;
          O )
          overwrite_all=true; break;;
          b )
          backup=true; break;;
          B )
          backup_all=true; break;;
          s|"" )
          skip=true; break;;
          S )
          skip_all=true; break;;
          * )
          user "Invalid choice. Pick one of [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all."
          ;;
        esac
      done
    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    if [ -e "$dst" ] || [ -L "$dst" ]
    then
      # $dst is still there (nothing was chosen to remove it) — never let
      # a bare `ln -s` blow up the whole run under `set -e`.
      success "skipped $src ($dst still exists)"
    else
      ln -s "$1" "$2"
      success "linked $1 to $2"
    fi
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  local src dst
  while IFS= read -r src
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done < <(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink')
}

setup_gitconfig
setup_npmconfig
setup_localrc
install_dotfiles

# If brew (Homebrew/Linuxbrew) exists, install and setup dependencies.
# Works on both macOS and Linux now — no more Darwin-only assumption.
if command -v brew >/dev/null 2>&1
then
  info "installing dependencies"
  if source bin/dot > /tmp/dotfiles-dot 2>&1
  then
    success "dependencies installed"
  else
    fail "error installing dependencies"
  fi
fi

echo ''
echo '  All installed!'
