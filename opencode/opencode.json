{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "niksmac/OpenAgentsControl",
    "@franlol/opencode-md-table-formatter@latest"
  ],
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "enabled": true
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ],
        "enabled": true
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": ["/home/niksmac/.local/bin/codebase-memory-mcp"],
        "enabled": true
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    }
  },
  "formatter": true,
  "share": "disabled"
}
