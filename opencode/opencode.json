{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@franlol/opencode-md-table-formatter@latest"],
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": ["/Users/niksmac/.local/bin/codebase-memory-mcp"]
    }
  },
  "formatter": true,
  "share": "disabled"
}
