{
  "context_servers": {
    "codebase-memory-mcp": {
      "enabled": true,
      "remote": false,
      "command": "/Users/niksmac/.local/bin/codebase-memory-mcp",
      "args": [""]
    }
  },
  "search_wrap": true,
  "relative_line_numbers": "wrapped",
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "effort": "high",
        "model": "opencode-go/space-bunny-free",
        "mode": "build"
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "right"
  },
  "ui_font_family": "Monaco",
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "Dart": {
      "enable_language_server": false
    }
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "biome": {
      "settings": {
        "require_config_file": true
      },
      "binary": {
        "path": "/opt/homebrew/bin/biome",
        "arguments": ["lsp-proxy"]
      }
    }
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": false
  },
  "use_system_window_tabs": true,
  "debugger": {
    "button": true
  },
  "diagnostics": {
    "button": false
  },
  "status_bar": {
    "active_language_button": true
  },
  "language_models": {
    "openai_compatible": {
      "opencode-go": {
        "api_url": "https://opencode.ai/zen/go/v1",
        "custom_headers": {
          "x-opencode-session": "zed"
        },
        "available_models": [
          {
            "name": "qwen3.8-max",
            "display_name": "Qwen3.8 Max",
            "max_tokens": 1000000,
            "max_output_tokens": 131072
          },
          {
            "name": "glm-5.3",
            "display_name": "GLM 5.3",
            "max_tokens": 1000000,
            "max_output_tokens": 131072
          },
          {
            "name": "kimi-k3",
            "display_name": "Kimi K3",
            "max_tokens": 1048576,
            "max_output_tokens": 131072
          },
          {
            "name": "gpt-6-luna",
            "display_name": "GPT-6 Luna",
            "max_tokens": 1050000,
            "max_output_tokens": 128000
          },
          {
            "name": "deepseek-v4-pro",
            "display_name": "DeepSeek V4 Pro",
            "max_tokens": 1000000,
            "max_output_tokens": 384000
          },
          {
            "name": "space-bunny-free",
            "display_name": "Space Bunny (free)",
            "max_tokens": 1048576,
            "max_output_tokens": 524288
          }
        ]
      },
      "OpenCode": {
        "api_url": "https://opencode.ai/zen/v1",
        "available_models": [
          {
            "name": "big-pickle",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": true
            }
          }
        ]
      }
    }
  },
  "server_url": "https://zed.dev",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "none"
  },
  "base_keymap": "Atom",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "tab_size": 2,
  "preferred_line_length": 80,
  "soft_wrap": "bounded",
  "show_wrap_guides": true,
  "wrap_guides": [80, 100],
  "buffer_font_size": 16,
  "buffer_font_family": "Monaco",
  "ui_font_size": 16,
  "format_on_save": "on",
  "vim_mode": false,
  "terminal": {
    "font_family": "Monaco",
    "blinking": "off",
    "font_size": 16,
    "working_directory": "current_project_directory"
  },
  "auto_install_extensions": {
    "html": true,
    "astro": true,
    "atomize": true,
    "emmet": true,
    "env": true,
    "jsonnet": true,
    "solidity": true,
    "toml": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "use_autoclose": true,
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    }
  },
  "journal": {
    "path": "~",
    "hour_format": "hour12"
  },
  "calls": {
    "mute_on_join": true,
    "share_on_join": false
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/node_modules"
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "opencode-go",
      "model": "qwen3.8-max"
    },
    "inline_alternatives": [
      {
        "provider": "opencode-go",
        "model": "qwen3.8-max"
      },
      {
        "provider": "OpenCode",
        "model": "big-pickle"
      }
    ]
  },
  "jupyter": {
    "kernel_selections": {
      "python": "conda-env",
      "typescript": "deno",
      "javascript": "deno"
    }
  },
  "context_servers": {
  "codebase-memory-mcp": {"command":"/home/niksmac/.local/bin/codebase-memory-mcp","args":[]}
}
}
