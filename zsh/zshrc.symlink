# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles
export ZSH_CUSTOM=$HOME/.zsh/custom

# Load OS detection and canonical tool paths (brew, zplug, fnm, etc.)
source "$ZSH/init/env"

# Disable XON/XOFF so Ctrl+S passes through (freezes terminal otherwise on Linux)
stty -ixon

# your project folder that we can `c [tab]` to
export PROJECTS=~/Code

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# Ad-hoc machine-local exports that installers append to (gitignored dir).
if [[ -d ~/.zshrc.d ]]
then
  for file in ~/.zshrc.d/*.zsh(N); do
    source "$file"
  done
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit && compinit -C

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# -----------------------------
# zplug
# -----------------------------

# Suppress job control notifications before zplug runs
setopt LOCAL_OPTIONS NO_NOTIFY NO_MONITOR

# ZPLUG_HOME is already set by init/env via brew
# Fallback: manual zplug install
if [ -z "$ZPLUG_HOME" ] && [ -f "$HOME/.zplug/init.zsh" ]; then
    export ZPLUG_HOME="$HOME/.zplug"
fi

if [ -n "$ZPLUG_HOME" ] && [ -f "$ZPLUG_HOME/init.zsh" ]; then
    source "$ZPLUG_HOME/init.zsh"
fi

zstyle ':zplug:*' verbose false

# zplug itself
# zplug "zplug/zplug", hook-build:"zplug --self-manage"

# Better shell UX
zplug "zsh-users/zsh-autosuggestions", defer:2
zplug "zsh-users/zsh-syntax-highlighting", defer:3
zplug "zsh-users/zsh-completions", defer:2

# Useful helpers
zplug "MichaelAquilina/zsh-you-should-use", defer:3
zplug "peterhurford/up.zsh", defer:3
zplug "babarot/enhancd", use:"init.sh", defer:2

# Load oh-my-zsh plugins only if you really use them
zplug "plugins/git", from:oh-my-zsh
if [ "$IS_MAC" = true ]; then
  zplug "plugins/macos", from:oh-my-zsh
fi
# fnm handled by eval "$(fnm env --use-on-cd)" below - don't use oh-my-zsh plugin
zplug "plugins/yarn", from:oh-my-zsh

# Optional: can slow shell startup
# zplug "plugins/thefuck", from:oh-my-zsh
# zplug "plugins/git-flow-avh", from:oh-my-zsh
# zplug "plugins/rand-quote", from:oh-my-zsh
# zplug "plugins/genpass", from:oh-my-zsh

if ! zplug check; then
  zplug install
fi

zplug load

# Locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8

# fnm — Node.js version manager (PATH is set in init/env)
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd)"
fi
export PATH="$HOME/flutter/bin:$PATH"

# Android SDK
export ANDROID_HOME=/data/android/Sdk
export PATH=$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH

# Node version comes from `fnm env --use-on-cd` above. Do not prepend a
# pinned fnm node-versions path here: it shadows whatever version the
# current directory's .node-version resolves to.

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section

if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
  source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

# Added by codebase-memory-mcp install
export PATH="/home/niksmac/.local/bin:$PATH"

export BUN_OPTIONS="${BUN_OPTIONS:+$BUN_OPTIONS }--preload=$HOME/.local/share/no-agent-summary.js"

export PATH=/Users/niksmac/.opencode/bin:$PATH
