# Ghostty config — ported from iterm/ (Default profile + hybrid-reduced-contrast)
# iTerm source: iterm/com.googlecode.iterm2.plist, iterm/hybrid-reduced-contrast.itermcolors
# Docs: https://ghostty.org/docs/config — validate with: ghostty +show-config

# --- Font (iTerm: Monaco 15, no custom Non-ASCII font) ---
font-family = "Monaco"
font-size = 14

# --- Theme: hybrid-reduced-contrast (iTerm Background/Foreground) ---
theme = Atom One Dark
background = #1b2125
foreground = #b9bcba

# Cursor (iTerm: Cursor #21ffff, Cursor Text = background, blinking underline)
cursor-color = #21ffff
cursor-text = #1b2125
cursor-style = block
cursor-style-blink = true

# Selection (iTerm: Selection = foreground bg, Selected Text = background fg)
selection-background = #b9bcba
selection-foreground = #1b2125

# Palette (iTerm Ansi 0-15, hybrid-reduced-contrast)
# black
palette = 0=#222e36
palette = 8=#333f47
# red
palette = 1=#922f33
palette = 9=#bf5053
# green
palette = 2=#7a8431
palette = 10=#a6b254
# yellow
palette = 3=#d4804d
palette = 11=#ebbb61
# blue
palette = 4=#4d6d8b
palette = 12=#6f90b0
# magenta
palette = 5=#71527c
palette = 13=#a27fac
# cyan
palette = 6=#4d7b74
palette = 14=#79b2a8
# white
palette = 7=#59676d
palette = 15=#b9bcba

# Bold uses bright palette (iTerm: Use Bright Bold = true, Bold Font = true)
bold-color = bright

# --- Terminal behavior (iTerm: xterm-256color, UTF-8, mouse reporting on) ---
term = xterm-256color
shell-integration = detect
scrollback-limit = 1000
mouse-hide-while-typing = true
clipboard-read = allow
clipboard-write = allow
copy-on-select = false

# Bell (iTerm: Silence Bell off, Visual Bell on → audible + visual)
bell-features = audio,attention,title

# --- Working directory (iTerm: Custom Directory → ~/Code) ---
working-directory = "~/Code"
window-inherit-working-directory = true
split-inherit-working-directory = true
tab-inherit-working-directory = true

# --- Window chrome (iTerm: HideTab when single, opaque, no blur) ---
window-theme = system
window-show-tab-bar = auto
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
background-opacity = 1.0
background-blur = false

# Default launch size: medium window (~120 cols x 32 rows), never maximized.
# window-save-state = never stops Ghostty from reopening at the last
# (possibly fullscreen/expanded) size.
window-width = 120
window-height = 32
window-save-state = never

# Close without prompting (iTerm: Close Sessions On End, PromptOnQuit off)
confirm-close-surface = false
quit-after-last-window-closed = true

# Option key: iTerm used Normal (both sides); sane dev setup is left=Alt
# (word jumps in zsh/tmux), right stays for USInternational-PC accents.
# Your plist locale: com.apple.keylayout.USInternational-PC
macos-option-as-alt = left

# --- Keybinds: iTerm muscle memory on Linux -------------------------------
# Ghostty's built-in clipboard/tab defaults are ctrl+shift+{c,v,t} on Linux.
# Cmd (super) bindings are macOS-only defaults, so they must be declared
# explicitly here or they fall through to the shell as literal bytes.
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
# Logitech Mac-layout keyboard: the key labeled "Cmd" sends ctrl on Linux,
# so alias the common shortcuts to ctrl+ as well.
keybind = ctrl+c=copy_to_clipboard:mixed
keybind = ctrl+v=paste_from_clipboard

# Tabs & windows
keybind = super+t=new_tab
keybind = super+n=new_window
keybind = super+w=close_tab
keybind = super+q=quit
keybind = ctrl+t=new_tab
keybind = ctrl+n=new_window
keybind = ctrl+w=close_tab
keybind = ctrl+q=quit
# NB: no super+shift+left/right — GNOME binds those to move-to-workspace
# and consumes them. Ghostty's ctrl+shift+arrow_left/right defaults do tabs.
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=last_tab

# Splits à la iTerm (Cmd+D vertical, Cmd+Shift+D horizontal)
# NB: GNOME's wm binds <Super>d to show-desktop at the compositor level,
# so super+d is swallowed before Ghostty sees it. Use ctrl+shift+o/e
# (Ghostty defaults, left alone) for splits on GNOME.
keybind = super+shift+d=new_split:down
keybind = ctrl+alt+d=new_split:right
keybind = ctrl+alt+shift+d=new_split:down
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+ctrl+alt+left=resize_split:left,10
keybind = super+ctrl+alt+right=resize_split:right,10
